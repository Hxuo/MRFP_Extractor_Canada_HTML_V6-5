cd /d "D:\Projects"

set "P=MRFP_Extractor_Canada_HTML_v6-5"

REM CREATE FOLDERS
mkdir "%P%"
mkdir "%P%\Assets\Icons"
mkdir "%P%\css"
mkdir "%P%\vendor\pdfjs"
mkdir "%P%\js\core"
mkdir "%P%\js\fmc"
mkdir "%P%\dev-tools"

REM MAIN APPLICATION
if not exist "%P%\index.html" type nul > "%P%\index.html"

REM CSS
if not exist "%P%\css\style.css" type nul > "%P%\css\style.css"

REM APPLICATION JAVASCRIPT
for %F in (app engine evidence-locator evidence-viewer excel-export pdf-reader storage) do @if not exist "%P%\js\%F.js" type nul > "%P%\js\%F.js"

REM SHARED CORE
for %F in (evidence-engine evidence-utils extraction-engine fmc-registry shared-utils) do @if not exist "%P%\js\core\%F.js" type nul > "%P%\js\core\%F.js"

REM ALL 33 FMC ADAPTERS
for %F in (agf blackrock bmg bmo brandes ci cibc desjardins dynamic fidelity first_trust franklin global_x hamilton harvest ig_mackenzie leith_wheeler lysander mackenzie manulife middlefield nbi nei newgen ninepoint pender purpose rbc rpia scotia sun_life td vanguard) do @if not exist "%P%\js\fmc\%F.js" type nul > "%P%\js\fmc\%F.js"

REM FMC ADAPTER TEMPLATE
if not exist "%P%\js\fmc\ADAPTER_TEMPLATE.txt" type nul > "%P%\js\fmc\ADAPTER_TEMPLATE.txt"

REM BUILD SYSTEM
if not exist "%P%\dev-tools\build.cjs" type nul > "%P%\dev-tools\build.cjs"
if not exist "%P%\dev-tools\fmc-manifest.json" type nul > "%P%\dev-tools\fmc-manifest.json"

REM PDF.JS PLACEHOLDERS
if not exist "%P%\vendor\pdfjs\pdf.min.js" type nul > "%P%\vendor\pdfjs\pdf.min.js"
if not exist "%P%\vendor\pdfjs\pdf.worker.min.js" type nul > "%P%\vendor\pdfjs\pdf.worker.min.js"

REM DISPLAY COMPLETE STRUCTURE
echo.
echo MRFP EXTRACTOR V6-5 SKELETON CREATED
tree "%P%" /F
